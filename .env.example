# Spotify application credentials
SPOTIFY_ID=your_spotify_client_id
SPOTIFY_SECRET=your_spotify_client_secret

# No trailing slash. Spotify requires the full callback URL to be registered.
SPOTIFY_REDIRECT_HOST=http://127.0.0.1:9999

# Local defaults
ADDR=0.0.0.0:9999
LOG_LEVEL=info
SQLITE_DB_PATH=/tmp/recommendli.sqlite
